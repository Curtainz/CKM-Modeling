# 定义需要处理的健康状态列名
health_conditions <- c("hypertension", "diabetesOrHB", "heartProblem", "stoke", "kidneyDisease")
# 遍历每种健康状态
for (condition in health_conditions) {
# 拼接列名
condition_2011 <- paste0(condition, "_11")
verify_2013 <- paste0("verify_", condition, "_13")
verify_2015 <- paste0("verify_", condition, "_15")
# 检查 2013 年的验证数据
data[[condition_2011]] <- ifelse(
data[[verify_2013]] == 2, # 如果 2013 年验证数据为 2
ifelse(data[[condition_2011]] == 1, 2,
ifelse(data[[condition_2011]] == 2, 1, NA)), # 翻转数据
data[[condition_2011]] # 否则保持原值
)
# 检查 2015 年的验证数据
data[[condition_2011]] <- ifelse(
data[[verify_2015]] == 2, # 如果 2015 年验证数据为 2
ifelse(data[[condition_2011]] == 1, 2,
ifelse(data[[condition_2011]] == 2, 1, NA)), # 翻转数据
data[[condition_2011]] # 否则保持原值
)
}
