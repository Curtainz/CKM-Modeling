(
(!is.na(data$BMI) & data$BMI >= 23) |
(
((!is.na(waist) & ((gender == 1 & waist >= 90) | (gender == 2 & waist >= 80)))) |
((!is.na(data$bl_glu) & data$bl_glu >= 124)) |
((!is.na(data$bl_hba1c) & (data$bl_hba1c <= 6.4) & (data$bl_hba1c >= 5.7)))
)
