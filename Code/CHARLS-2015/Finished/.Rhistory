(!is.na(data$newtg) & data$newtg < 150) &
(!is.na(data$hypert) & data$hypert == 2) &
(!is.na(data$diabetes_hbs) & data$diabetes_hbs == 2) &
(!is.na(data$heart_disease) & data$heart_disease == 2) &
(!is.na(data$kidney_disease) & data$kidney_disease == 2),
0, NA))
